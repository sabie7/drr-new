# ── DRR Chat environment ─────────────────────────────────────────────
# Copy to .env on ANY host, fill values, run:  npm install && npm start
# MongoDB is EXTERNAL (Atlas) → your data never moves between hosts.

# Required — database (same Atlas cluster works on every host)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/chat_db?retryWrites=true&w=majority

# Optional — overrides (defaults are safe)
PORT=3000
ADMIN_PASS=                 # extra CP password fallback (empty = disabled)

# Portability — which origins may open sockets/calls to THIS host
PRIMARY_HOST=drr-chat.bonto.run
EXTRA_ORIGINS=              # comma-separated extra hostnames
