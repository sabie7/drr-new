# Kaz Alwadi Chat — Environment Configuration
# Copy this to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# MongoDB (required)
MONGO_URI=mongodb://localhost:27017/chat_db

# Security (required in production)
JWT_SECRET=change-this-to-a-random-secret
ADMIN_PASS=change-this-to-a-strong-password
ADMIN_USER=admin

# CORS — allowed origins (comma-separated, * for all in dev)
EXTRA_ORIGINS=

# Upload limits
MAX_UPLOAD_MB=10
